<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnLightTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Light Theme"
        android:backgroundTint="@color/white"
        android:textColor="@color/black"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnDarkTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dark Theme"
        android:backgroundTint="@color/black"
        android:textColor="@color/white"/>

    <EditText
        android:id="@+id/etOldPasskey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Current Passkey"
        android:inputType="numberPassword"/>

    <EditText
        android:id="@+id/etNewPasskey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="New Passkey"
        android:inputType="numberPassword"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/etConfirmPasskey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Confirm New Passkey"
        android:inputType="numberPassword"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnChangePasskey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Change Passkey"
        android:layout_marginTop="16dp"/>

</LinearLayout>